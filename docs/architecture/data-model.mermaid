erDiagram
  USER {
    bigint id PK
    string email
    datetime marketing_opt_in_at
    string marketing_opt_in_source
    datetime marketing_opt_out_at
    string marketing_opt_out_reason
  }

  ACCOUNT {
    bigint id PK
    bigint owner_id FK
    boolean personal
    datetime archived_at
    integer account_users_count
    integer learner_limit
    boolean complimentary_premium
    string complimentary_premium_note
  }

  %% learner_limit is the configurable Premium cap (default 10). Free-family
  %% capacity is Account::FREE_LEARNER_LIMIT (2), intentionally not persisted.
  %% Account derives its current capacity from plan entitlement; Learner
  %% validates new and restored active records against that capacity.

  ACCOUNT_USER {
    bigint id PK
    bigint account_id FK
    bigint user_id FK
    jsonb roles
  }

  LEARNER {
    bigint id PK
    bigint account_id FK
    string name
    string grade_level
    string color
    datetime archived_at
    boolean kept_on_free
  }

  COURSE {
    bigint id PK
    bigint account_id FK
    string name
    string subject
  }

  ENROLLMENT {
    bigint id PK
    bigint course_id FK
    bigint learner_id FK
  }

  %% account_users.account_id and account_users.user_id are required. The
  %% counter cache on accounts is also required and backfilled by the
  %% EnforceMembershipColumnNulls migration.

  ACCOUNT_INVITATION {
    bigint id PK
    bigint account_id FK
    bigint invited_by_id FK
    string name
    string email
    string token
    jsonb roles
  }

  API_TOKEN {
    bigint id PK
    bigint user_id FK
  }

  CONNECTED_ACCOUNT {
    bigint id PK
    bigint owner_id FK
    string owner_type
  }

  NOTIFICATION_TOKEN {
    bigint id PK
    bigint user_id FK
  }

  LOOPS_WEBHOOK_EVENT {
    bigint id PK
    string webhook_id
    string event_name
    datetime event_time
    jsonb payload
    datetime processed_at
  }

  PAY_CUSTOMER {
    bigint id PK
    bigint owner_id
    string owner_type
    string processor
    string processor_id
  }

  PAY_SUBSCRIPTION {
    integer id PK
    bigint customer_id FK
    string processor_id
    string processor_plan
    integer quantity
    datetime current_period_end
  }

  PLAN {
    bigint id PK
    string name
    string interval
    string stripe_id
  }

  USER ||--o| ACCOUNT_USER : one membership
  ACCOUNT ||--o{ ACCOUNT_USER : admin parents
  ACCOUNT ||--o{ LEARNER : learners
  ACCOUNT ||--o{ COURSE : classes
  COURSE ||--o{ ENROLLMENT : enrollments
  LEARNER ||--o{ ENROLLMENT : enrollments

  %% Accounts are Family records: personal is constrained false, each family
  %% has at most two admin parents, and archived accounts retain billing
  %% history after their former parent joins another family.
  %% Learners belong to one family. A unique expression index prevents
  %% case-insensitive duplicate names within that family; archived_at supports
  %% restoring a learner without deleting their record. Only active learners
  %% consume the Family's learner_limit / FREE_LEARNER_LIMIT capacity.
  %% kept_on_free marks the learners a downgraded (Free) family chose to keep
  %% active when over FREE_LEARNER_LIMIT; set via Account#keep_learners_on_free.
  %% Courses are classes in the UI. They belong to one family and enroll zero
  %% or more learners through ENROLLMENT. The unique course_id/learner_id index
  %% permits each learner to be enrolled in a class at most once.
  USER ||--o{ ACCOUNT : owns
  ACCOUNT ||--o{ ACCOUNT_INVITATION : invitations
  USER o|--o{ ACCOUNT_INVITATION : invites
  USER ||--o{ API_TOKEN : api_tokens
  USER ||--o{ CONNECTED_ACCOUNT : connected_accounts
  USER ||--o{ NOTIFICATION_TOKEN : notification_tokens
  ACCOUNT ||--o{ PAY_CUSTOMER : billing_owner
  PAY_CUSTOMER ||--o{ PAY_SUBSCRIPTION : subscriptions

  %% Pay::Subscription::PlanSchedule adds yearly-to-monthly renewal scheduling.
  %% Stripe stores the schedule; no local schedule table or plan FK is added.
  %% Pay::Subscription#plan resolves Plan from processor_plan via the
  %% processor-specific price ID (stripe_id for Stripe), not an association.
  %% Account releases a pending schedule before cancelling billable subscriptions.

  %% MarketingConsent is a User concern. Consent state is stored on users,
  %% rather than in a separate record, to keep one current preference per user.

  %% LOOPS_WEBHOOK_EVENT has no FK to USER: LoopsWebhookEventProcessor
  %% resolves the user from the payload's contactIdentity (userId/email) at
  %% processing time, not via a stored association. webhook_id is uniquely
  %% indexed for replay dedupe (30-day retention outlives Loops' 24h retries).
