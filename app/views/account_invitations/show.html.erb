<% Current.meta_tags.set(title: t(".title", account: @account.name)) %>

<div class="mt-12 max-w-md">
  <h1 class="h3 text-foreground"><%= t(".title", account: @account.name) %></h1>

  <div class="mt-8 flex items-center gap-2 text-sm text-muted-foreground">
    <%= render AvatarComponent.new(
      src: avatar_url_for(@account_invitation.account),
      alt: @account_invitation.account.name,
      size: :xs
    ) %>

    <div>
      <%= t(".invited_you_to_join_html", inviter: @account_invitation.invited_by.name, account: @account_invitation.account.name) %>
    </div>
  </div>

  <div class="mt-8">
    <%= render AlertComponent.new(title: "You will become an admin.", description: "You can manage this family, including billing and receipts.", variant: :info) %>
  </div>

  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <%= form_with url: account_invitation_path(@account_invitation.token), method: :put, class: "w-full sm:w-auto" do %>
      <%= render ButtonComponent.new(text: t(".accept"), type: "submit", full_width: true, classes: "sm:w-auto") %>
    <% end %>
    <%= form_with url: account_invitation_path(@account_invitation.token), method: :delete, class: "w-full sm:w-auto", data: {turbo_confirm: t(".decline_confirm", account: @account.name)} do %>
      <%= render ButtonComponent.new(text: t(".decline"), variant: :secondary, type: "submit", full_width: true, classes: "sm:w-auto") %>
    <% end %>
  </div>
</div>
