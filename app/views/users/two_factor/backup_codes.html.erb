<%= turbo_frame_tag "modal-lazy-content" do %>
  <h3 class="modal-heading"><%= t(".title") %></h3>
  <p class="mt-2 text-sm text-muted-foreground"><%= t(".save_codes") %></p>
  <div class="mt-4 grid grid-cols-2 gap-2 text-center"><% current_user.otp_backup_codes.each do |code| %><code><%= code %></code><% end %></div>
  <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"><%= render ButtonComponent.new(text: t("cancel"), variant: :secondary, data: {action: "click->ui-modal#close:prevent"}) %><%= render ButtonComponent.new(text: t(".next"), href: verify_user_two_factor_path) %></div>
<% end %>
