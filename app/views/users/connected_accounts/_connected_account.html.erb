<div class="flex items-center justify-between gap-4 rounded-md border border-neutral-200 p-4 dark:border-neutral-700">
  <div>
    <%= image_tag connected_account.image_url, referrerpolicy: "no-referrer", alt: "", class: "inline-block h-10 w-10 rounded-sm shadow-sm mr-2" %>
    <div class="inline-block align-middle">
      <div>Google</div>
      <div class="text-sm text-muted-foreground"><%= connected_account.name %></div>
    </div>
  </div>
  <%= form_with url: user_connected_account_path(connected_account), method: :delete do %>
    <%= render ButtonComponent.new(text: t(".disconnect"), variant: :secondary, type: "submit", data: {turbo_confirm: t(".disconnect_confirm")}) %>
  <% end %>
</div>
