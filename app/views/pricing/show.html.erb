<div class="container m-auto my-12">
  <div class="flex flex-wrap justify-center">
    <div class="text-center">
      <h1><%= t(".heading") %></h1>
      <p class="mt-2 text-xl text-muted-foreground"><%= t(".subhead") %></p>
    </div>
  </div>

  <div data-controller="pricing"
       data-pricing-active-frequency-class="shadow-xs text-black hover:text-black bg-white dark:text-white dark:hover:text-white dark:bg-gray-900"
       data-pricing-inactive-plans-class="hidden"
       data-pricing-hidden-toggle-class="hidden"
       class="mt-8 sm:flex flex-wrap items-center justify-center">

    <div data-pricing-target="toggle" class="hidden relative self-center my-8 bg-(--divider-color) rounded-full p-0.5 flex sm:mt-8">
      <button type="button" data-action="pricing#switch" data-pricing-target="frequency" data-frequency="monthly" class="relative w-1/2 border-border rounded-full py-2 text-sm font-medium whitespace-nowrap focus:outline-hidden focus:z-10 sm:w-auto sm:px-8"><%= t('.monthly') %></button>
      <button type="button" data-action="pricing#switch" data-pricing-target="frequency" data-frequency="yearly" class="ml-0.5 relative w-1/2 border border-transparent rounded-full py-2 text-sm font-medium whitespace-nowrap focus:outline-hidden focus:z-10 sm:w-auto sm:px-8"><%= t('.yearly') %></button>
    </div>

    <% subscription = current_account&.pay_subscriptions&.where(status: %w[active past_due])&.first %>
    <% free_family = user_signed_in? && current_account.free? %>

    <div data-turbo-prefetch="false" class="w-full lg:px-0 px-2">
      <% {"monthly" => @monthly_plans, "yearly" => @yearly_plans}.each do |frequency, plans| %>
        <div data-pricing-target="plans" data-frequency="<%= frequency %>" class="<%= "hidden " unless frequency == "monthly" %>grid lg:grid-flow-col lg:auto-cols-fr gap-4">
          <%= tag.div if plans.empty? %>
          <%= render "pricing/free_card", free_family: free_family %>
          <% plans.each do |plan| %>
            <%= render "pricing/premium_card", plan: plan, yearly: frequency == "yearly", free_family: free_family, subscription: subscription %>
          <% end %>
          <%= tag.div if plans.empty? %>
        </div>
      <% end %>
    </div>
  </div>

  <p class="mt-6 text-center text-sm text-muted-foreground"><%= t(".no_refunds") %></p>
</div>
