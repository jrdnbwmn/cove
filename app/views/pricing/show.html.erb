<div class="container m-auto my-12">
  <div class="flex flex-wrap justify-center">
    <div class="text-center">
      <h1><%= t(".heading") %></h1>
      <p class="mt-2 text-xl text-muted-foreground"><%= t(".subhead") %></p>
    </div>
  </div>

  <div data-controller="pricing"
       data-pricing-active-frequency-class="shadow-xs text-black hover:text-black bg-white dark:text-white dark:hover:text-white dark:bg-gray-900"
       data-pricing-inactive-plans-class="hidden"
       data-pricing-hidden-toggle-class="hidden"
       class="mt-8 sm:flex flex-wrap items-center justify-center">

    <div data-pricing-target="toggle" class="hidden relative self-center my-8 bg-(--divider-color) rounded-full p-0.5 flex sm:mt-8">
      <button type="button" data-action="pricing#switch" data-pricing-target="frequency" data-frequency="monthly" class="relative w-1/2 border-border rounded-full py-2 text-sm font-medium whitespace-nowrap focus:outline-hidden focus:z-10 sm:w-auto sm:px-8"><%= t('.monthly') %></button>
      <button type="button" data-action="pricing#switch" data-pricing-target="frequency" data-frequency="yearly" class="ml-0.5 relative w-1/2 border border-transparent rounded-full py-2 text-sm font-medium whitespace-nowrap focus:outline-hidden focus:z-10 sm:w-auto sm:px-8"><%= t('.yearly') %></button>
    </div>

    <% subscription = current_account&.pay_subscriptions&.where(status: %w[active past_due])&.first %>

    <div data-turbo-prefetch="false" class="w-full lg:px-0 px-2">
      <div data-pricing-target="plans" data-frequency="monthly" class="grid lg:grid-flow-col lg:auto-cols-fr gap-4">
        <%= tag.div if @monthly_plans.count.zero? %>
        <%= render PlanCardComponent.new(
          name: t(".free.name"),
          description: t(".free.description"),
          price_text: "$0",
          price_note: t(".free.price_note"),
          features: t(".free.features", student_limit: Account::FREE_STUDENT_LIMIT)
        ) do %>
          <% if !user_signed_in? %>
            <%= render ButtonComponent.new(text: t(".free.get_started"), href: new_user_registration_path, variant: :secondary, size: :lg, full_width: true) %>
          <% elsif current_account.free? %>
            <%= render ButtonComponent.new(text: t(".free.current_plan"), variant: :secondary, size: :lg, full_width: true, disabled: true) %>
          <% end %>
        <% end %>
        <% @monthly_plans.each do |plan| %>
          <%= render PlanCardComponent.new(plan: plan, description: t(".premium.description"), features: t(".premium.features", student_limit: premium_student_limit)) do %>
            <% if plan.contact_url.present? %>
              <%= render ButtonComponent.new(text: t("billing.subscriptions.plan.contact_us"), href: plan.contact_url, variant: :secondary, size: :lg, full_width: true) %>
            <% elsif !user_signed_in? %>
              <%= render ButtonComponent.new(text: t(".premium.get_premium"), href: checkout_path(plan: plan), variant: :secondary, size: :lg, full_width: true) %>
            <% elsif current_account.free? %>
              <%= render ButtonComponent.new(text: t(".premium.upgrade"), href: checkout_path(plan: plan), variant: :secondary, size: :lg, full_width: true) %>
            <% elsif subscription&.plan == plan || current_account.complimentary_premium? %>
              <%= render ButtonComponent.new(text: t(".premium.current_plan"), variant: :secondary, size: :lg, full_width: true, disabled: true) %>
            <% else %>
              <%= render ButtonComponent.new(text: t(".premium.change_plan"), href: edit_billing_subscription_path(subscription), variant: :secondary, size: :lg, full_width: true) %>
            <% end %>
          <% end %>
        <% end %>
        <%= tag.div if @monthly_plans.count.zero? %>
      </div>
      <div data-pricing-target="plans" data-frequency="yearly" class="hidden grid lg:grid-flow-col lg:auto-cols-fr gap-4">
        <%= tag.div if @yearly_plans.count.zero? %>
        <%= render PlanCardComponent.new(
          name: t(".free.name"),
          description: t(".free.description"),
          price_text: "$0",
          price_note: t(".free.price_note"),
          features: t(".free.features", student_limit: Account::FREE_STUDENT_LIMIT)
        ) do %>
          <% if !user_signed_in? %>
            <%= render ButtonComponent.new(text: t(".free.get_started"), href: new_user_registration_path, variant: :secondary, size: :lg, full_width: true) %>
          <% elsif current_account.free? %>
            <%= render ButtonComponent.new(text: t(".free.current_plan"), variant: :secondary, size: :lg, full_width: true, disabled: true) %>
          <% end %>
        <% end %>
        <% @yearly_plans.each do |plan| %>
          <%= render PlanCardComponent.new(
            plan: plan,
            description: t(".premium.description"),
            price_text: monthly_equivalent(plan),
            price_note: t(".premium.yearly_price_note", amount: pay_amount_to_currency(plan, strip_insignificant_zeros: true)),
            features: t(".premium.features", student_limit: premium_student_limit)
          ) do %>
            <% if plan.contact_url.present? %>
              <%= render ButtonComponent.new(text: t("billing.subscriptions.plan.contact_us"), href: plan.contact_url, variant: :secondary, size: :lg, full_width: true) %>
            <% elsif !user_signed_in? %>
              <%= render ButtonComponent.new(text: t(".premium.get_premium"), href: checkout_path(plan: plan), variant: :secondary, size: :lg, full_width: true) %>
            <% elsif current_account.free? %>
              <%= render ButtonComponent.new(text: t(".premium.upgrade"), href: checkout_path(plan: plan), variant: :secondary, size: :lg, full_width: true) %>
            <% elsif subscription&.plan == plan || current_account.complimentary_premium? %>
              <%= render ButtonComponent.new(text: t(".premium.current_plan"), variant: :secondary, size: :lg, full_width: true, disabled: true) %>
            <% else %>
              <%= render ButtonComponent.new(text: t(".premium.change_plan"), href: edit_billing_subscription_path(subscription), variant: :secondary, size: :lg, full_width: true) %>
            <% end %>
          <% end %>
        <% end %>
        <%= tag.div if @yearly_plans.count.zero? %>
      </div>
    </div>
  </div>

  <p class="mt-6 text-center text-sm text-muted-foreground"><%= t(".no_refunds") %></p>
</div>
