<% Current.meta_tags.set(title: @account.name) %>
<% is_admin = account_admin?(@account, current_user) %>
<% content_for :sidebar, render(partial: "account_navbar") %>

<%= render PageHeaderComponent.new(title: @account.name) do |header| %>
  <% if is_admin %>
    <% header.with_primary_action do %>
      <%= render "application/lazy_modal", title: t(".edit_account"), src: edit_account_path(@account), text: t(".edit_account"), button: {variant: :secondary} %>
    <% end %>
  <% end %>
<% end %>

<section>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h2 class="h3"><%= t(".parents") %></h2>
    <% if is_admin %>
      <%= render "application/lazy_modal", title: t(".invite"), src: new_account_account_invitation_path(@account), text: t(".invite"), button: {variant: :secondary} %>
    <% end %>
  </div>
  <% if @account.account_users_count >= 2 %><p class="mb-4 text-sm text-muted-foreground"><%= t(".parent_limit") %></p><% end %>
  <div class="row-list">
    <% @account.account_users.includes(user: {avatar_attachment: :blob}).each do |account_user| %>
      <%= render "accounts/parent_row", account: @account, account_user: account_user, is_admin: is_admin %>
    <% end %>
    <% @account.account_invitations.each do |invitation| %>
      <%= render "accounts/invitation_row", account: @account, invitation: invitation, is_admin: is_admin %>
    <% end %>
  </div>
</section>

<% if @account.owner?(current_user) %>
  <section class="mt-12">
    <h2 class="h3"><%= t(".delete_family") %></h2>
    <p class="mt-2 text-sm text-muted-foreground"><%= family_deletion_description(@account) %></p>
    <%= button_to t(".delete_family"), account_path(@account), method: :delete, class: "mt-4", data: {turbo_confirm: t(".delete_confirm", name: @account.name), turbo_confirm_description: family_deletion_description(@account)} %>
  </section>
<% end %>
