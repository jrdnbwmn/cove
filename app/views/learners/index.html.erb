<%= render PageHeaderComponent.new(title: t(".title"), description: t(".description")) do |header| %>
  <% if @learners.any? %>
    <% header.with_primary_action do %>
      <% if Current.account.can_add_learner? %>
        <%= render "add_trigger" %>
      <% else %>
        <%= render "limit_modal", account: Current.account %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if Current.account.over_free_learner_limit? %>
  <%= render "free_limit_banner", account: Current.account %>
<% end %>

<% if @archived_count.positive? %>
  <%# AIDEV-NOTE: Active/Archived is an underline-tab list switch (ux-notes, Sections and tabs). It shows whenever archived learners exist, even when no active ones do, so they stay reachable. %>
  <div class="mb-4">
    <%= render UiTabsComponent.new(mode: :links, variant: :underline, label: t(".filter_label"), tab_list_classes: "w-full border-b border-neutral-200") do |tabs| %>
      <% tabs.with_tab(title: t(".active"), href: learners_path, active: !@show_archived, meta: @learners.size.to_s) %>
      <% tabs.with_tab(title: t(".archived"), href: learners_path(archived: 1), active: @show_archived, meta: @archived_count.to_s) %>
    <% end %>
  </div>
<% end %>

<% if @show_archived %>
  <% can_restore = Current.account.can_add_learner? %>
  <% unless can_restore %>
    <p class="mb-4 text-sm text-muted-foreground">
      <% if Current.account.premium? %>
        <%= t(".restore_blocked_premium_html", link: mail_to(Jumpstart.config.support_email, t(".restore_contact"), subject: t("learners.limit_modal.more_learners_subject", product: Jumpstart.config.application_name), class: "underline text-foreground hover:text-primary")) %>
      <% else %>
        <%= t(".restore_blocked_free_html", link: link_to(t(".restore_upgrade"), pricing_path, class: "underline text-foreground hover:text-primary")) %>
      <% end %>
    </p>
  <% end %>
  <div class="grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @archived_learners.each do |learner| %>
      <%= render "learner_card", learner: learner, archived: true, can_restore: can_restore %>
    <% end %>
  </div>
<% elsif @learners.empty? %>
  <%= render EmptyStateComponent.new(title: t(".empty_title"), description: t(".empty_description")) do |c| %>
    <% c.with_icon do %>
      <%= icon "users", class: "w-full h-full" %>
    <% end %>
    <% c.with_primary_action do %>
      <%= render "add_trigger" %>
    <% end %>
  <% end %>
<% else %>
  <div class="grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @learners.each do |learner| %>
      <%= render "learner_card", learner: learner %>
    <% end %>
  </div>
<% end %>
