<%= form_with model: learner, id: "learner-form", class: "flex flex-col gap-y-5" do |form| %>
  <%# AIDEV-NOTE: Model-level errors (e.g. the learner limit) belong to no field, so show them as an alert above the fields. %>
  <% learner.errors[:base].each do |message| %>
    <%= render AlertComponent.new(title: message, variant: :error) %>
  <% end %>

  <%= render FormFieldComponent.new(label: t("learners.form.name"), name: "learner[name]", required: true, error: learner.errors[:name].first) do |field| %>
    <% field.with_input do %>
      <%= form.text_field :name, required: true, autofocus: true, maxlength: Learner::MAX_LENGTH, autocomplete: "off", class: class_names("form-control", error: learner.errors[:name].any?) %>
    <% end %>
  <% end %>

  <%= render SelectComponent.new(
    label: t("learners.form.grade_level"),
    name: "learner[grade_level]",
    id: "learner_grade_level",
    options: Learner::GRADE_LEVELS + [[t("learners.form.no_grade_level"), ""]],
    selected: learner.grade_level.to_s,
    placeholder: nil,
    clearable: false,
    error: learner.errors[:grade_level].first,
    data: {select_allow_empty_option_value: true}
  ) %>

  <%= render "learners/color_picker", form: form, learner: learner %>
<% end %>

<%= render layout: "learners/actions", locals: {learner: learner} do %>
  <%= render ButtonComponent.new(text: t(learner.new_record? ? "learners.form.add" : "learners.form.save"), type: "submit", form: "learner-form") %>
<% end %>
