<%# locals: (learner:, close_on_cancel:) %>
<h2 class="modal-heading"><%= t("learners.delete.heading", name: learner.name) %></h2>
<p class="mt-2 text-muted-foreground"><%= t("learners.delete.body", name: learner.name) %></p>

<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
  <%# AIDEV-NOTE: List and archived confirms close the modal on Cancel. Confirms reached from Edit or the read-only view swap their prior content back into this modal. %>
  <% if close_on_cancel %>
    <%# The delete form's hidden method field registers as a changed field. A confirmation has no entered work, so close it directly without the outer edit form's discard check. %>
    <%= render ButtonComponent.new(text: t("learners.delete.cancel"), variant: :secondary, data: {action: "click->ui-modal#performClose:prevent"}) %>
  <% else %>
    <%= render ButtonComponent.new(text: t("learners.delete.cancel"), variant: :secondary, href: learner.editable? ? edit_learner_path(learner) : learner_path(learner)) %>
  <% end %>
  <%= form_with url: learner_path(learner), method: :delete do %>
    <%= render ButtonComponent.new(text: t("learners.delete.confirm", name: learner.name), variant: :destructive, type: "submit", full_width: true) %>
  <% end %>
</div>
