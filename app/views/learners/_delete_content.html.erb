<%# locals: (learner:, close_on_cancel:) %>
<% link_count = learner.enrollments.count %>
<%= render "application/delete_summary",
  heading: t("learners.delete.heading", name: learner.name),
  links: (t("learners.delete.links", count: link_count, name: learner.name) if link_count.positive?),
  body: t(learner.archived? ? "learners.delete.archived_body" : "learners.delete.body", name: learner.name) %>

<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
  <%# AIDEV-NOTE: List and archived confirms close the modal on Cancel. Confirms reached from Edit swap the edit form back into this modal. %>
  <% if close_on_cancel %>
    <%# The delete form's hidden method field registers as a changed field. A confirmation has no entered work, so close it directly without the outer edit form's discard check. %>
    <%= render ButtonComponent.new(text: t("learners.delete.cancel"), variant: :secondary, data: {action: "click->ui-modal#performClose:prevent"}) %>
  <% else %>
    <%= render ButtonComponent.new(text: t("learners.delete.cancel"), variant: :secondary, href: edit_learner_path(learner)) %>
  <% end %>
  <%= form_with url: learner_path(learner), method: :delete do %>
    <%= render ButtonComponent.new(text: t("learners.delete.confirm", name: learner.name), variant: :destructive, type: "submit", full_width: true, classes: "whitespace-normal! wrap-anywhere") %>
  <% end %>
</div>
