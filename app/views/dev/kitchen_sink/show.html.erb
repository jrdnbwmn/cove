<div class="mx-auto max-w-5xl px-6 py-10">
  <h1>Component Kitchen Sink</h1>

  <div class="mt-8 divide-y divide-border">
    <section class="py-10 first:pt-0">
      <h2>Buttons</h2>
      <div class="mt-6 flex flex-wrap items-center gap-6">
        <%= render ButtonComponent.new(text: "Primary", variant: :primary) %>
        <%= render ButtonComponent.new(text: "Secondary", variant: :secondary) %>
        <%= render ButtonComponent.new(text: "Outline", variant: :outline) %>
        <%= render ButtonComponent.new(text: "Ghost", variant: :ghost) %>
        <%= render ButtonComponent.new(text: "Destructive", variant: :destructive) %>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-6">
        <%= render ButtonComponent.new(text: "Extra small", size: :xs) %>
        <%= render ButtonComponent.new(text: "Small", size: :sm) %>
        <%= render ButtonComponent.new(text: "Medium", size: :md) %>
        <%= render ButtonComponent.new(text: "Large", size: :lg) %>
      </div>
    </section>

    <section class="py-10">
      <h2>Forms</h2>
      <div class="mt-6 grid gap-8 md:grid-cols-2">
        <%= render FormFieldComponent.new(label: "Display name", name: "profile[display_name]", helper_text: "Shown to collaborators.", required: true) do |component| %>
          <% component.with_input do %>
            <input autocomplete="nickname" class="form-control" id="profile_display_name" name="profile[display_name]" type="text">
          <% end %>
        <% end %>

        <%= render FormFieldComponent.new(label: "Biography", name: "profile[biography]", size: :lg) do |component| %>
          <% component.with_input do %>
            <textarea class="form-control" id="profile_biography" name="profile[biography]" rows="3"></textarea>
          <% end %>
        <% end %>

        <%= render FormFieldComponent.new(label: "Email", name: "user[email]", error: "Email is invalid.", variant: :floating) do |component| %>
          <% component.with_input do %>
            <input autocomplete="email" class="form-control error" id="user_email" name="user[email]" type="email">
          <% end %>
        <% end %>

        <%= render FormFieldComponent.new(label: "Account ID", name: "account[id]", disabled: true, size: :md) do |component| %>
          <% component.with_input do %>
            <input autocomplete="off" class="form-control" disabled id="account_id" name="account[id]" type="text" value="ACC-123">
          <% end %>
        <% end %>
      </div>

      <div class="mt-8 grid gap-8 md:grid-cols-2">
        <%= render CheckboxComponent.new(label: "Receive product updates", name: "preferences[product_updates]", checked: true, description: "A checked checkbox with supporting text.") %>
        <%= render RadioComponent.new(label: "Team", name: "plan", value: "team", checked: true, description: "A selected radio option.") %>
        <%= render SwitchComponent.new(label: "Enable weekly summary", name: "preferences[weekly_summary]", checked: true, show_icons: true) %>
        <%= render SwitchComponent.new(label: "Enable weekly summary", name: "preferences[weekly_summary_default]") %>
        <%= render SelectComponent.new(label: "Plan", name: "subscription[plan]", options: [["Starter", "starter"], ["Team", "team"], ["Enterprise", "enterprise"]]) %>
        <%= render PasswordComponent.new(name: "user[password]", hint: "Use at least 8 characters.") %>
      </div>

      <div class="mt-8 grid gap-8 md:grid-cols-3">
        <%= render CheckboxComponent.new(label: "Small", name: "preferences[product_updates_sm]", checked: true, size: :sm) %>
        <%= render CheckboxComponent.new(label: "Medium", name: "preferences[product_updates_md]", checked: true, size: :md) %>
        <%= render CheckboxComponent.new(label: "Large", name: "preferences[product_updates_lg]", checked: true, size: :lg) %>

        <%= render RadioComponent.new(label: "Small", name: "plan_sm", value: "team", checked: true, size: :sm) %>
        <%= render RadioComponent.new(label: "Medium", name: "plan_md", value: "team", checked: true, size: :md) %>
        <%= render RadioComponent.new(label: "Large", name: "plan_lg", value: "team", checked: true, size: :lg) %>

        <%= render SwitchComponent.new(label: "Small", name: "preferences[weekly_summary_sm]", checked: true, size: :sm) %>
        <%= render SwitchComponent.new(label: "Medium", name: "preferences[weekly_summary_md]", checked: true, size: :md) %>
        <%= render SwitchComponent.new(label: "Large", name: "preferences[weekly_summary_lg]", checked: true, size: :lg) %>
      </div>
    </section>

    <section class="py-10">
      <h2>Feedback</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <%= render AlertComponent.new(title: "Success! Your changes have been saved", description: "All updates have been applied successfully.", variant: :success) %>
        <%= render AlertComponent.new(title: "Something went wrong", description: "We couldn't process your request.", variant: :error) %>
        <%= render AlertComponent.new(title: "Your plan is expiring soon", variant: :warning) %>
        <%= render AlertComponent.new(title: "New features are available", variant: :info) %>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <%= render BadgeComponent.new(text: "Neutral") %>
        <%= render BadgeComponent.new(text: "Published", variant: :green) %>
        <%= render BadgeComponent.new(text: "Active", variant: :blue, dot: true) %>
        <%= render BadgeComponent.new(text: "Beta", variant: :purple, pill: true) %>
        <%= render BadgeComponent.new(text: "Filter: Active", variant: :neutral, removable: true) %>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-8">
        <%= render LoadingIndicatorComponent.new %>
        <%= render LoadingIndicatorComponent.new(stepped: true) %>
        <%= render LoadingIndicatorComponent.new(type: :dots) %>
        <%= render LoadingIndicatorComponent.new(type: :bars) %>
        <%= render LoadingIndicatorComponent.new(type: :progress, progress: 65) %>
        <%= render LoadingIndicatorComponent.new(color: :primary, text: "Loading...") %>
      </div>

      <div class="mt-8 grid max-w-sm gap-3">
        <%= render SkeletonComponent.new(count: 3) %>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-6">
        <button class="rounded-md border border-border px-3 py-2" type="button" data-controller="toast-preview" data-toast-preview-type-value="success" data-toast-preview-message-value="Changes saved" data-toast-preview-description-value="Your updates have been saved successfully." data-action="click->toast-preview#show">Show success toast</button>
        <button class="rounded-md border border-border px-3 py-2" type="button" data-controller="toast-preview" data-toast-preview-type-value="error" data-toast-preview-message-value="Something went wrong" data-toast-preview-description-value="We couldn't process your request." data-action="click->toast-preview#show">Show error toast</button>
        <%= render UiToastComponent.new(position: "bottom-right") %>
        <%= render TooltipComponent.new(text: "Rails Blocks tooltip", placement: "top") do %>
          <button class="rounded-md border border-border px-3 py-2" type="button">Rails Blocks tooltip</button>
        <% end %>
      </div>
    </section>

    <section class="py-10">
      <h2>Overlays</h2>
      <div class="mt-6 flex flex-wrap items-start gap-6">
        <%= render UiModalComponent.new(title: "Invite a teammate", trigger_text: "Open modal") do |modal| %>
          <p class="text-sm text-muted-foreground">Choose a teammate to invite to this project.</p>
          <% modal.with_footer do %>
            <%= render ButtonComponent.new(text: "Cancel", variant: :secondary, data: { action: "click->ui-modal#close:prevent" }) %>
            <%= render ButtonComponent.new(text: "Send invite") %>
          <% end %>
        <% end %>

        <%= render DropdownComponent.new(trigger_text: "Project actions", placement: "bottom-end") do |dropdown| %>
          <% dropdown.with_item_link(text: "Project settings", href: "#") %>
          <% dropdown.with_item_link(text: "Manage members", href: "#") %>
          <% dropdown.with_item_divider %>
          <% dropdown.with_item_button(text: "Archive project", destructive: true) %>
        <% end %>
      </div>
    </section>

    <section class="py-10">
      <h2>Navigation</h2>
      <div class="mt-6 grid gap-8">
        <%= render NavbarComponent.new do |navbar| %>
          <% navbar.with_item(label: "Dashboard", href: "#") %>
          <% navbar.with_item(label: "Resources", dropdown: true, content_id: "navigation-resources") %>
          <% navbar.with_dropdown_content(id: "navigation-resources", columns: 2) do %>
            <a class="rounded-md p-2 hover:bg-muted" href="#">Guides</a>
            <a class="rounded-md p-2 hover:bg-muted" href="#">Support</a>
          <% end %>
        <% end %>

        <%= render BreadcrumbComponent.new(items: [{label: "Home", href: "#"}, {label: "Projects", href: "#"}, {label: "Roadmap"}], separator: :chevron, variant: :with_background) %>

        <%= render BreadcrumbComponent.new(items: [{label: "Home", href: "#"}, {label: "Projects", href: "#", icon: icon("folder", class: "size-4")}, {label: "Roadmap"}], variant: :with_icons) %>

        <%= render UiTabsComponent.new(variant: :underline) do |tabs| %>
          <% tabs.with_tab(title: "Overview", id: "overview") %>
          <% tabs.with_tab(title: "Activity", id: "activity") %>
          <% tabs.with_panel do %>Overview content<% end %>
          <% tabs.with_panel do %>Activity content<% end %>
        <% end %>

        <%= render UiTabsComponent.new(orientation: :vertical, variant: :low_contrast) do |tabs| %>
          <% tabs.with_tab(title: "Settings", id: "settings") %>
          <% tabs.with_tab(title: "Members", id: "members") %>
          <% tabs.with_panel do %>Settings content<% end %>
          <% tabs.with_panel do %>Members content<% end %>
        <% end %>

        <% navigation_pagy = Pagy::Offset.new(count: 30, page: 2, limit: 10, request: Pagy::Request.new(request: request)) %>
        <%= render PaginationComponent.new(pagy: navigation_pagy, request_path: request.path) %>

        <div class="overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-800">
        <%= render SidebarComponent.new(show_mobile_toggle: false, min_height_class: "min-h-[500px]") do |sidebar| %>
          <% sidebar.with_item(label: "New chat", href: "#", icon: icon("square-pen", class: "size-4 sm:size-4.5")) %>
          <% sidebar.with_item(label: "Search", href: "#", icon: icon("search", class: "size-4 sm:size-4.5")) %>
          <% sidebar.with_item(label: "Library", href: "#", icon: icon("library", class: "size-4 sm:size-4.5")) %>

          <% sidebar.with_section(title: "Projects") do |section| %>
            <% section.with_item(label: "New project", href: "#", icon: icon("folder-plus", class: "size-4 sm:size-4.5")) %>
            <% section.with_item(label: "Rails Blocks", href: "#", icon: icon("folder", class: "size-4 sm:size-4.5")) %>
          <% end %>

          <% sidebar.with_section(title: "Chats") do |section| %>
            <% section.with_item(label: "How to build a Rails app", href: "#") %>
            <% section.with_item(label: "Why are gems called gems", href: "#") %>
            <% section.with_item(label: "How to use Hotwire", href: "#") %>
          <% end %>

          <% sidebar.with_footer do %>
            <button class="w-full flex items-center gap-2 rounded-md px-1 sm:px-1.5 py-1 sm:py-1.5 text-left text-sm text-neutral-700 hover:bg-neutral-100 focus-visible:bg-neutral-100 focus:outline-hidden disabled:cursor-not-allowed disabled:opacity-50 dark:text-neutral-100 dark:hover:bg-neutral-700/50 dark:focus-visible:bg-neutral-700/50">
              <%= render AvatarComponent.new(alt: "Jordan Lee", size: :xs) %>
              <div class="min-w-0">
                <div class="truncate text-xs">Jordan Lee</div>
              </div>
            </button>
          <% end %>

          <% sidebar.with_collapsed_footer do %>
            <button class="w-full flex items-center gap-2 rounded-md px-1 sm:px-1.5 py-1 sm:py-1.5 text-left text-sm text-neutral-700 hover:bg-neutral-100 focus-visible:bg-neutral-100 focus:outline-hidden disabled:cursor-not-allowed disabled:opacity-50 dark:text-neutral-100 dark:hover:bg-neutral-700/50 dark:focus-visible:bg-neutral-700/50">
              <%= render AvatarComponent.new(alt: "Jordan Lee", size: :xs) %>
            </button>
          <% end %>

          <p class="p-6 text-sm text-muted-foreground">Sidebar content area</p>
        <% end %>
        </div>
      </div>
    </section>

    <section class="py-10">
      <h2>Data Display</h2>

        <div class="mt-6 flex items-center gap-4">
          <%= render AvatarComponent.new(alt: "Avery Stone") %>
          <%= render AvatarComponent.new(src: "/icon.svg", alt: "Jordan Lee", size: :lg, status: :online) %>
          <% member_group = AvatarComponent::GroupComponent.new(label: "Project members", remaining_count: 2) %>
          <% member_group.with_avatar(alt: "Avery Stone") %>
          <% member_group.with_avatar(alt: "Jordan Lee") %>
          <%= render member_group %>
        </div>

      <div class="mt-6 grid items-start gap-6 md:grid-cols-2">
        <%= render CardComponent.new.with_content("A default card with standard content padding.") %>

        <%= render CardComponent.new(variant: :well).with_content("A low-emphasis well card.") %>

        <% starter_plan = Plan.new(name: "Starter", amount: 1900, interval: "month", description: "A plan-card example with a price, features, and an action.", details: {features: ["Unlimited projects", "Email support"]}) %>
        <%= render PlanCardComponent.new(plan: starter_plan) do %>
          <%= render ButtonComponent.new(text: "Start trial", href: "#", full_width: true) %>
        <% end %>

        <% project_table = TableComponent.new(striped: true, hoverable: true) %>
        <% project_table.with_column(label: "Project") %>
        <% project_table.with_column(label: "Owner") %>
        <% project_table.with_row do |row| %>
          <% row.with_cell(primary: true) { "Onboarding" } %>
          <% row.with_cell { "Avery Stone" } %>
        <% end %>
        <% project_table.with_row do |row| %>
          <% row.with_cell(primary: true) { "Billing" } %>
          <% row.with_cell { "Jordan Lee" } %>
        <% end %>
        <%= render project_table %>
      </div>
    </section>

    <section class="py-10">
      <h2>Icons</h2>
      <div class="mt-6 flex flex-wrap items-center gap-6">
        <%= icon "inbox", class: "size-5" %>
        <%= icon "airplay", class: "size-5" %>
        <%= icon "alarm-clock", class: "size-5" %>
        <%= icon "anchor", class: "size-5" %>
        <%= icon "aperture", class: "size-5" %>
        <%= icon "archive", class: "size-5" %>
        <%= icon "atom", class: "size-5" %>
        <%= icon "badge-check", class: "size-5" %>
        <%= icon "banana", class: "size-5" %>
        <%= icon "battery-charging", class: "size-5" %>
        <%= icon "bell-ring", class: "size-5" %>
        <%= icon "between-horizontal-start", class: "size-5" %>
        <%= icon "bike", class: "size-5" %>
        <%= icon "blend", class: "size-5" %>
        <%= icon "bot", class: "size-5" %>
      </div>
    </section>

    <section class="py-10">
      <h2>Empty State</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <%= render EmptyStateComponent.new(title: "No projects yet", description: "Create your first project to get organized and start collaborating.", bordered: true) do |c| %>
          <% c.with_icon { icon "folder", class: "w-full h-full" } %>
          <% c.with_primary_action { render ButtonComponent.new(text: "New project", href: "#") } %>
        <% end %>

        <%= render EmptyStateComponent.new(title: "No results found", description: "Try adjusting your search or filters.", size: :sm, bordered: true) do |c| %>
          <% c.with_icon { icon "search", class: "w-full h-full" } %>
          <% c.with_secondary_action { render ButtonComponent.new(text: "Clear filters", variant: :ghost, size: :sm) } %>
        <% end %>
      </div>
    </section>
  </div>
</div>
