<% begun = school_year.starts_on_in_database <= school_year.account.today %>
<% starts_locked = begun && school_year.tracked_from.nil? %>
<% starts_help = begun ? (starts_locked ? "The year has started." : "The year has started. You can only move the start earlier.") : nil %>

<%= form_with model: school_year, url: planner_school_year_path, class: "flex flex-col gap-6" do |form| %>
  <% school_year.errors[:base].each do |message| %>
    <p class="text-sm text-red-600"><%= message %></p>
  <% end %>
  <%= render FormFieldComponent.new(label: "Starts", name: "school_year[starts_on]", helper_text: starts_help, error: school_year.errors[:starts_on].first) do |field| %>
    <% field.with_input do %>
      <%= form.date_field :starts_on, class: "form-control", required: true, disabled: starts_locked %>
    <% end %>
  <% end %>
  <%= render FormFieldComponent.new(label: "Ends", name: "school_year[ends_on]", error: school_year.errors[:ends_on].first) do |field| %>
    <% field.with_input do %>
      <%= form.date_field :ends_on, class: "form-control", required: true %>
    <% end %>
  <% end %>
  <fieldset aria-describedby="school-weekdays-help school-weekdays-error">
    <legend class="mb-2 text-sm font-medium">School days</legend>
    <%= hidden_field_tag "school_year[school_weekdays][]", "", id: nil %>
    <div class="flex flex-wrap gap-2">
      <% %w[Mon Tue Wed Thu Fri Sat Sun].each_with_index do |day, index| %>
        <% value = (index + 1) % 7 %>
        <%= render ToggleChipComponent.new(label: day, name: "school_year[school_weekdays][]", value: value, checked: school_year.school_weekdays.to_a.include?(value)) %>
      <% end %>
    </div>
    <p class="mt-2 text-sm text-muted-foreground" id="school-weekdays-help">Changes apply from today. Past days stay as they were.</p>
    <p class="mt-1 text-sm text-red-600" id="school-weekdays-error"><%= school_year.errors[:school_weekdays].first %></p>
  </fieldset>
  <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
    <%= render ButtonComponent.new(text: "Cancel", variant: :outline, data: {action: "click->ui-modal#close:prevent"}) %>
    <%= render ButtonComponent.new(text: "Save", type: "submit") %>
  </div>
<% end %>
