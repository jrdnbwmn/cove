<%= render "planners/header", active_tab: :school_year %>

<div class="mt-6 sm:mt-8 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
  <div class="min-w-0">
    <p><%= school_year_summary(@school_year) %></p>
    <% if @school_year.ended? %>
      <p class="mt-2 text-muted-foreground">Planning next year is coming soon. Your records for this year are kept.</p>
    <% end %>
  </div>
  <% unless @school_year.ended? %>
    <div class="flex shrink-0 flex-col gap-3 lg:flex-row">
      <%= render "application/lazy_modal", src: new_planner_school_year_break_path, text: "Add time off", button: {variant: :secondary, classes: "w-full"} %>
      <%= render "application/lazy_modal", src: edit_planner_school_year_path, text: "Edit year", button: {variant: :secondary, classes: "w-full"} %>
    </div>
  <% end %>
</div>

<div id="time-off-restore-error" role="alert" class="mt-4 text-sm text-red-700 empty:hidden"><%= flash[:restore_error] %></div>

<section class="mt-8 sm:mt-12" aria-labelledby="time-off-heading">
  <h2 id="time-off-heading" class="mb-4">Time off</h2>
  <% if @school_year.breaks.any? %>
    <div class="divide-y divide-border">
      <%= render partial: "break", collection: @school_year.breaks.ordered, as: :time_off %>
      <% unless @school_year.ended? %>
        <div id="time-off-inline-add">
          <%= render "application/lazy_modal", src: new_planner_school_year_break_path, text: "Add time off", row: true %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= render EmptyStateComponent.new(title: "No time off yet.", description: "Add some when you plan days off.", heading_level: 3) do |empty_state| %>
      <% unless @school_year.ended? %>
        <% empty_state.with_primary_action do %>
          <%= render "application/lazy_modal", src: new_planner_school_year_break_path, text: "Add time off" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>
