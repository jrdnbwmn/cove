<div class="container m-auto">
  <section class="py-24 max-w-2xl m-auto text-center flex flex-col items-center justify-center">
    <h1 class="mb-4"><%= t(".headline") %></h1>
    <p class="mb-8 text-muted-foreground leading-normal text-xl"><%= t(".subhead") %></p>
    <%= render ButtonComponent.new(text: t(".cta"), variant: :primary, size: :lg, href: new_user_registration_path) %>
  </section>

  <section class="pb-16 grid gap-8 lg:grid-cols-3">
    <% %w[plan records day].each do |key| %>
      <div>
        <h3 class="mb-2"><%= t(".value_points.#{key}.heading") %></h3>
        <p class="text-muted-foreground"><%= t(".value_points.#{key}.body") %></p>
      </div>
    <% end %>
  </section>

  <% if @monthly_plans.any? || @yearly_plans.any? %>
    <section class="pb-24">
      <h2 class="text-center"><%= t(".pricing_heading") %></h2>
      <%= render "pricing/plans", monthly_plans: @monthly_plans, yearly_plans: @yearly_plans %>
    </section>
  <% end %>
</div>
