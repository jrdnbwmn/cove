<% Current.meta_tags.set(title: t(".title")) %>

<% content_for :sidebar, render(partial: "account_navbar") %>

<%= form_with(model: current_user, url: account_password_path, local: true, html: { method: :put }, class: "max-w-md") do |f| %>
  <%= render "error_messages", resource: current_user %>

  <%= render PasswordComponent.new(
    label: current_user.class.human_attribute_name(:current_password),
    name: "user[current_password]",
    id: "user_current_password",
    autocomplete: "current-password",
    placeholder: "•••••••",
    error: current_user.errors[:current_password].first,
    hint: t("devise.registrations.edit.we_need_your_current_password_to_confirm_your_changes"),
    classes: "mb-6"
  ) %>

  <%= render PasswordComponent.new(
    label: current_user.class.human_attribute_name(:password),
    name: "user[password]",
    id: "user_password",
    autocomplete: "new-password",
    placeholder: "•••••••",
    error: current_user.errors[:password].first,
    hint: t("devise.shared.minimum_password_length", count: User.password_length.min),
    classes: "mb-6"
  ) %>

  <%= render PasswordComponent.new(
    label: current_user.class.human_attribute_name(:password_confirmation),
    name: "user[password_confirmation]",
    id: "user_password_confirmation",
    autocomplete: "new-password",
    placeholder: "•••••••",
    error: current_user.errors[:password_confirmation].first,
    classes: "mb-6"
  ) %>

  <%= render ButtonComponent.new(text: t(".update"), type: "submit") %>
<% end %>

<hr>

<h2 class="h4"><%= t(".set_password.title") %></h2>
<p class="mt-2 mb-4 text-sm text-muted-foreground"><%= t(".set_password.description") %></p>
<div>
  <%= render ButtonComponent.new(
    text: t(".set_password.button"),
    variant: :secondary,
    href: account_password_reset_link_path,
    data: {turbo_method: :post}
  ) %>
</div>

<div class="mt-12">
  <h2 class="h4"><%= t(".two_factor.title") %></h2>
  <p class="mt-2 mb-4 text-sm text-muted-foreground"><%= t(".two_factor.description") %></p>
<% if current_user.otp_required_for_login? %>
  <div>
    <%= render ButtonComponent.new(
      text: t(".two_factor.disable"),
      variant: :destructive,
      href: user_two_factor_path,
      data: {turbo_method: :delete, turbo_confirm: t("are_you_sure")}
    ) %>
  </div>
<% else %>
    <%= render UiModalComponent.new(title: t(".two_factor.title")) do |modal| %>
      <% modal.with_trigger do %><%= render ButtonComponent.new(text: t(".two_factor.enable"), variant: :secondary, data: {action: "click->ui-modal#open:prevent"}) %><% end %>
      <%= turbo_frame_tag "modal-lazy-content" do %>
        <p class="text-muted-foreground">Set up an authenticator app to protect your account.</p>
        <%= form_with url: backup_codes_user_two_factor_path, class: "mt-6 flex justify-end" do %><%= render ButtonComponent.new(text: "Next", type: "submit") %><% end %>
      <% end %>
    <% end %>
<% end %>
</div>

<div class="mt-12">
  <h2 class="h4"><%= t(".connected_accounts.title") %></h2>
  <% connected_accounts = current_user.connected_accounts.order(provider: :asc, created_at: :desc) %>
  <% if connected_accounts.any? %>
    <div class="mt-4 grid gap-4"><%= render partial: "users/connected_accounts/connected_account", collection: connected_accounts %></div>
  <% else %>
    <p class="mt-2 text-sm text-muted-foreground"><%= t(".connected_accounts.empty") %></p>
    <%= form_with url: omniauth_authorize_path(:user, :google_oauth2), class: "mt-4", data: {turbo: false} do %>
      <%= render ButtonComponent.new(text: t(".connected_accounts.connect"), variant: :secondary, type: "submit") %>
    <% end %>
  <% end %>
</div>
