<% pick_needed = account.student_pick_needed? %>
<%# AIDEV-NOTE: Before a pick is saved this is a prominent card; afterwards it shrinks to a one-line reminder. Both open the same picker modal. %>
<% picker = render "application/lazy_modal", title: t("students.kept.title"), src: edit_students_kept_path, text: t(pick_needed ? "students.free_limit_banner.choose" : "students.free_limit_banner.change"), button: {variant: pick_needed ? :primary : :ghost, size: :sm} %>
<% upgrade_link = link_to t("students.free_limit_banner.upgrade"), pricing_path, class: "underline" %>
<% if pick_needed %>
  <%= render CardComponent.new(classes: "mb-4") do |card| %>
    <% card.with_body do %>
      <p class="font-medium"><%= t("students.free_limit_banner.heading", limit: Account::FREE_STUDENT_LIMIT) %></p>
      <p class="mt-1 text-sm text-muted-foreground"><%= t("students.free_limit_banner.description") %></p>
      <div class="mt-4 flex items-center gap-3 text-sm">
        <%= picker %>
        <%= upgrade_link %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <p class="mb-4 text-sm text-muted-foreground">
    <%= t("students.free_limit_banner.picked", limit: Account::FREE_STUDENT_LIMIT) %>
    <%= picker %>
    <%= upgrade_link %>
  </p>
<% end %>
