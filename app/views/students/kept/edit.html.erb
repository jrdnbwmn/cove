<%= turbo_frame_tag "modal-lazy-content" do %>
  <%= form_with url: students_kept_path, method: :patch, class: "flex flex-col gap-y-5", data: {controller: "pick-limit", pick_limit_limit_value: Account::FREE_STUDENT_LIMIT} do %>
    <% Current.account.errors[:base].each do |message| %>
      <%= render AlertComponent.new(title: message, variant: :error) %>
    <% end %>
    <p class="text-sm text-muted-foreground"><%= t("students.kept.intro", limit: Account::FREE_STUDENT_LIMIT) %></p>
    <div class="grid gap-3">
      <% @students.each do |student| %>
        <%= render CheckboxComponent.new(label: student.name, name: "student_ids[]", value: student.id, checked: @selected_ids ? @selected_ids.include?(student.id.to_s) : student.kept_on_free?, description: student.grade_level, data: {pick_limit_target: "checkbox", action: "change->pick-limit#change"}) %>
      <% end %>
    </div>
    <div class="flex justify-end gap-3">
      <%= render ButtonComponent.new(text: t("students.form.cancel"), variant: :outline, data: {action: "click->ui-modal#close:prevent"}) %>
      <%= render ButtonComponent.new(text: t("students.form.save"), type: "submit", data: {pick_limit_target: "submit"}) %>
    </div>
  <% end %>
<% end %>
