<%= form_with model: student, id: "student-form", class: "flex flex-col gap-y-5" do |form| %>
  <%# AIDEV-NOTE: Model-level errors (e.g. the student limit) belong to no field, so show them as an alert above the fields. %>
  <% student.errors[:base].each do |message| %>
    <%= render AlertComponent.new(title: message, variant: :error) %>
  <% end %>

  <%= render FormFieldComponent.new(label: t("students.form.name"), name: "student[name]", required: true, error: student.errors[:name].first) do |field| %>
    <% field.with_input do %>
      <%= form.text_field :name, required: true, autofocus: true, maxlength: Student::MAX_LENGTH, autocomplete: "off", class: class_names("form-control", error: student.errors[:name].any?) %>
    <% end %>
  <% end %>

  <%= render FormFieldComponent.new(label: t("students.form.grade_level"), name: "student[grade_level]", error: student.errors[:grade_level].first) do |field| %>
    <% field.with_input do %>
      <%= form.text_field :grade_level, maxlength: Student::MAX_LENGTH, autocomplete: "off", placeholder: t("students.form.grade_level_placeholder"), class: class_names("form-control", error: student.errors[:grade_level].any?) %>
    <% end %>
  <% end %>

  <%= render "students/color_picker", form: form, student: student %>
<% end %>

<%# AIDEV-NOTE: The actions sit outside the form because Archive is its own form and forms can't nest.
    Save/Add points back at the form with the HTML form attribute. On phones the main action stacks first. %>
<div data-student-actions class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:items-center">
  <% if student.persisted? %>
    <%= render ButtonComponent.new(text: t("students.form.delete"), variant: :ghost, href: delete_student_path(student), classes: "text-red-600") %>
  <% end %>

  <div class="flex flex-col-reverse gap-3 sm:ml-auto sm:flex-row sm:items-center">
    <%= render ButtonComponent.new(text: t("students.form.cancel"), variant: :outline, data: {action: "click->ui-modal#close:prevent"}) %>
    <% if student.persisted? %>
      <%= form_with url: student_archive_path(student), method: :post, class: "contents" do %>
        <%= render ButtonComponent.new(text: t("students.form.archive"), variant: :secondary, type: "submit") %>
      <% end %>
    <% end %>
    <%= render ButtonComponent.new(text: t(student.new_record? ? "students.form.add" : "students.form.save"), type: "submit", form: "student-form") %>
  </div>
</div>
