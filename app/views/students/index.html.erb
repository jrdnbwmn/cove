<%= render PageHeaderComponent.new(title: t(".title"), description: t(".description")) do |header| %>
  <% if @students.any? %>
    <% header.with_primary_action do %>
      <% if Current.account.can_add_student? %>
        <%= render "add_trigger" %>
      <% else %>
        <%= render "limit_modal", account: Current.account %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if Current.account.over_free_student_limit? %>
  <%= render "free_limit_banner", account: Current.account %>
<% end %>

<% if @archived_count.positive? %>
  <%# AIDEV-NOTE: Active/Archived lives in the list toolbar (ux-notes, Lists). It shows whenever archived students exist, even when no active ones do, so they stay reachable. %>
  <div class="mb-4 flex flex-wrap items-center gap-3">
    <%= render SegmentedControlComponent.new(label: t(".filter_label")) do |control| %>
      <% control.with_option(text: t(".active"), href: students_path, selected: !@show_archived, count: @students.size) %>
      <% control.with_option(text: t(".archived"), href: students_path(archived: 1), selected: @show_archived, count: @archived_count) %>
    <% end %>
  </div>
<% end %>

<% if @show_archived %>
  <% can_restore = Current.account.can_add_student? %>
  <% unless can_restore %>
    <p class="mb-4 text-sm text-muted-foreground">
      <% if Current.account.premium? %>
        <%= t(".restore_blocked_premium_html", link: mail_to(Jumpstart.config.support_email, t(".restore_contact"), subject: t("students.limit_modal.more_students_subject", product: Jumpstart.config.application_name), class: "underline text-foreground hover:text-primary")) %>
      <% else %>
        <%= t(".restore_blocked_free_html", link: link_to(t(".restore_upgrade"), pricing_path, class: "underline text-foreground hover:text-primary")) %>
      <% end %>
    </p>
  <% end %>
  <div class="grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @archived_students.each do |student| %>
      <%= render "student_card", student: student, archived: true, can_restore: can_restore %>
    <% end %>
  </div>
<% elsif @students.empty? %>
  <%= render EmptyStateComponent.new(title: t(".empty_title"), description: t(".empty_description")) do |c| %>
    <% c.with_icon do %>
      <%= icon "users", class: "w-full h-full" %>
    <% end %>
    <% c.with_primary_action do %>
      <%= render "add_trigger" %>
    <% end %>
  <% end %>
<% else %>
  <div class="grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @students.each do |student| %>
      <%= render "student_card", student: student %>
    <% end %>
  </div>
<% end %>
