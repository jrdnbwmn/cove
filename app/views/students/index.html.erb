<div class="container mx-auto p-4">
  <div class="mb-8 flex items-center justify-between gap-4">
    <h1><%= t(".title") %></h1>
    <% if @students.any? %>
      <%= render "add_trigger" %>
    <% end %>
  </div>

  <% if @students.empty? %>
    <%= render EmptyStateComponent.new(title: t(".empty_title"), description: t(".empty_description")) do |c| %>
      <% c.with_icon do %>
        <%= icon "users", class: "w-full h-full" %>
      <% end %>
      <% c.with_primary_action do %>
        <%= render "add_trigger" %>
      <% end %>
    <% end %>
  <% else %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @students.each do |student| %>
        <%= render CardComponent.new do |card| %>
          <% card.with_body do %>
            <div class="flex items-start gap-3">
              <%= render "color_dot", student: student %>
              <div class="min-w-0">
                <p class="font-medium break-words"><%= student.name %></p>
                <% if student.grade_level.present? %>
                  <p class="text-sm text-muted-foreground break-words"><%= student.grade_level %></p>
                <% end %>
              </div>
            </div>
          <% end %>
          <% card.with_footer do %>
            <%= render UiModalComponent.new(title: t(".edit_title", name: student.name), lazy_load: true, turbo_frame_src: edit_student_path(student)) do |modal| %>
              <% modal.with_trigger do %>
                <%= render ButtonComponent.new(text: t(".edit"), variant: :secondary, size: :sm, data: {action: "click->ui-modal#open:prevent"}) %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
