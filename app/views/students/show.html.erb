<%= turbo_frame_tag "modal-lazy-content" do %>
  <h2 class="mb-2 font-sans text-lg font-semibold text-neutral-900 dark:text-white"><%= @student.name %></h2>
  <div class="flex flex-col gap-y-5">
    <div class="flex items-start gap-3">
      <%= render "students/color_dot", student: @student %>
      <div>
        <p class="font-medium"><%= @student.name %></p>
        <% if @student.grade_level.present? %><p class="text-sm text-muted-foreground"><%= @student.grade_level %></p><% end %>
      </div>
    </div>
    <p class="text-muted-foreground"><%= t("students.notices.read_only", name: @student.name) %></p>
    <%= render layout: "students/actions", locals: {student: @student} do %><% end %>
  </div>
<% end %>
