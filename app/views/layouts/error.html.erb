<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", media: "all" %>
  </head>

  <body>
    <header>
      <%= link_to root_path do %>
        <%= render "application/brand" %>
      <% end %>
    </header>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
