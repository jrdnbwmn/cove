<div data-course-actions class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:items-center">
  <% unless course.new_record? %>
    <%= render ButtonComponent.new(text: t("courses.form.delete"), href: delete_course_path(course), variant: :ghost, classes: "text-red-600") %>
  <% end %>
  <div class="flex flex-col-reverse gap-3 sm:ml-auto sm:flex-row sm:items-center">
    <%= render ButtonComponent.new(text: t("courses.form.cancel"), variant: :outline, data: {action: "click->ui-modal#close:prevent"}) %>
    <%= yield %>
  </div>
</div>
