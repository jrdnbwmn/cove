<%= render Current.meta_tags %>
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<%= viewport_meta_tag %>

<%# AIDEV-NOTE: preload the above-the-fold fonts (body + h1/h2); hrefs are digested Propshaft paths matching the @font-face URLs. %>
<%= preload_link_tag "Geist-Regular.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
<%= preload_link_tag "FabricSerifWeb-Regular.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
<%= javascript_importmap_tags %>
<%= stylesheet_link_tag "tailwind", media: "all", "data-turbo-track": "reload" %>
<%= render "payments_dependencies" %>
<%= yield :head %>

<%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
<%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) if respond_to?(:pwa_manifest_path) %>
