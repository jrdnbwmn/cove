<%= render UiTabsComponent.new(mode: :links, variant: :underline, classes: "min-w-0", tab_list_classes: "w-full border-b border-neutral-200 dark:border-neutral-700") do |tabs| %>
  <% tabs.with_tab(title: t(".profile"), href: edit_user_registration_path, active: profile_tab_active?) %>
  <% tabs.with_tab(title: t(".security"), href: edit_account_password_path, active: security_tab_active?) %>
  <% if Jumpstart.config.payments_enabled? && !hotwire_native_app? %>
    <% tabs.with_tab(title: t(".billing"), href: billing_path, active: billing_tab_active?) %>
  <% end %>
  <% tabs.with_tab(title: t(".family"), href: account_path(current_account), active: family_tab_active?) %>
  <% if defined? Refer %>
    <% tabs.with_tab(title: t(".referrals"), href: referrals_path, active: referrals_tab_active?) %>
  <% end %>
<% end %>
