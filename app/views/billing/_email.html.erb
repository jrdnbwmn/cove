<h2 class="section-heading"><%= t(".billing_email") %></h2>

<div class="mb-8">
  <%= form_with model: current_account, url: billing_path do |f| %>
    <p class="mb-4 text-muted-foreground"><%= t ".description" %></p>

    <div class="max-w-lg">
      <%= render FormFieldComponent.new(
        label: current_account.class.human_attribute_name(:billing_email),
        name: "account[billing_email]",
        error: current_account.errors[:billing_email].first,
        classes: "w-full"
      ) do |field| %>
        <% field.with_input do %>
          <%= f.email_field :billing_email, class: "form-control", placeholder: true %>
        <% end %>
      <% end %>
      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= render ButtonComponent.new(text: t(".save"), variant: :secondary, type: "submit", full_width: true, classes: "sm:w-auto", data: { disable_with: t(".saving") }) %>
      </div>
    </div>
  <% end %>
</div>
