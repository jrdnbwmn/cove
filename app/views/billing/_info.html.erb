<h2 class="section-heading"><%= t(".extra_billing_info") %></h2>

<div class="mb-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="max-w-lg">
      <p class="text-muted-foreground"><%= t ".additional_information" %></p>
      <% if current_account.extra_billing_info? %>
        <p class="mt-4 whitespace-pre-line text-sm"><%= current_account.extra_billing_info %></p>
      <% end %>
    </div>

    <%= render UiModalComponent.new(title: t(".extra_billing_info")) do |modal| %>
      <% modal.with_trigger do %>
        <%= render ButtonComponent.new(text: t("edit"), variant: :secondary, data: {action: "click->ui-modal#open:prevent"}) %>
      <% end %>

      <%= form_with model: current_account, url: billing_path do |f| %>
        <%= render FormFieldComponent.new(
          label: current_account.class.human_attribute_name(:extra_billing_info),
          name: "account[extra_billing_info]",
          error: current_account.errors[:extra_billing_info].first
        ) do |field| %>
          <% field.with_input do %>
            <%= f.text_area :extra_billing_info, class: "form-control", placeholder: true %>
          <% end %>
        <% end %>

        <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <%= render ButtonComponent.new(text: t(".save_info"), variant: :secondary, type: "submit", full_width: true, classes: "sm:w-auto", data: { disable_with: t(".saving") }) %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
