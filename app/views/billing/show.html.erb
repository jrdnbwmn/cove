<% Current.meta_tags.set(title: t(".title")) %>

<% content_for :sidebar, render(partial: "account_navbar") %>

<h1 class="h3"><%= t(".title") %></h1>

<% if Current.account_admin? %>
  <% subscriptions = @subscriptions %>
  <%= render "plan_state", subscription: subscriptions.first %>
  <% if subscriptions.any? %><section class="mt-12"><%= render partial: "billing/subscriptions/subscription", collection: subscriptions %></section><% end %>

  <% if subscriptions.any? %>
    <div class="mt-12"><%= render partial: "email" %></div>
    <div class="mt-12"><%= render partial: "info" %></div>
    <div class="mt-12"><%= render partial: "charges" %></div>
  <% end %>
<% else %>
  <p class="text-muted-foreground"><%= t(".contact_admin", account: current_account.name) %></p>
<% end %>
