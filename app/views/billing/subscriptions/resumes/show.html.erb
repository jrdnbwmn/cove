<% Current.meta_tags.set(title: t(".title")) %>

<%= turbo_frame_tag "modal-lazy-content" do %>
<div class="max-w-xl">
  <h2 class="font-sans text-lg font-semibold"><%= t ".title" %></h2>

  <%= render CardComponent.new(divide: true, classes: "mt-8") do |card| %>
    <% card.with_header do %>
      <%= render partial: "billing/subscriptions/summary", locals: { subscription: @subscription } %>
    <% end %>

    <% card.with_body do %>
      <%= render AlertComponent.new(title: t(".resume"), variant: :info, show_icon: false) %>
    <% end %>

    <% card.with_footer do %>
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= render ButtonComponent.new(text: t("cancel"), variant: :secondary, data: {action: "click->ui-modal#close:prevent"}) %>
        <%= form_with url: billing_subscription_resume_path(@subscription), method: :patch do %><%= render ButtonComponent.new(text: t(".button"), type: "submit", data: {disable_with: t(".processing")}) %><% end %>
      </div>
    <% end %>
  <% end %>
</div>
<% end %>
