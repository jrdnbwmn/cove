<% Current.meta_tags.set(title: t(".title")) %>

<%= turbo_frame_tag "modal-lazy-content" do %>
<div class="max-w-xl">
  <h2 class="modal-heading"><%= t ".title" %></h2>

  <%= render CardComponent.new(divide: true, classes: "mt-8") do |card| %>
    <% card.with_header do %>
      <%= render partial: "billing/subscriptions/summary", locals: { subscription: @subscription } %>
    <% end %>

    <% card.with_body do %>
      <div class="space-y-4 text-muted-foreground">
        <div class="font-semibold text-foreground"><%= t ".description", product: Jumpstart.config.application_name %></div>
        <div><%= t ".help_html", link: mail_to(Jumpstart.config.support_email, t(".contact_us"), subject: t(".subject", product: Jumpstart.config.application_name), class: "font-medium text-primary underline") %></div>
        <div><%= cancellation_end_notice(@subscription) %></div>
        <% if (pending_change = @subscription.pending_plan_change) %>
          <div><%= t(".pending_plan_change", date: friendly_date(pending_change[:starts_at])) %></div>
        <% end %>
        <% unless cancels_immediately?(@subscription) %>
          <div><%= t(".resume") %></div>
        <% end %>
      </div>
    <% end %>

    <% card.with_footer do %>
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= render ButtonComponent.new(text: t("cancel"), variant: :secondary, data: {action: "click->ui-modal#close:prevent"}) %>
        <%= form_with url: billing_subscription_cancel_path(@subscription), method: :delete do %><%= render ButtonComponent.new(text: t(".confirm"), variant: :destructive, type: "submit", data: {disable_with: t(".processing")}) %><% end %>
      </div>
    <% end %>
  <% end %>
</div>
<% end %>
