<h2 class="section-heading"><%= t(".title") %></h2>

<% if @charges.present? %>
  <div class="row-list">
    <% @charges.each do |charge| %>
      <div class="flex flex-col gap-2 p-4 sm:flex-row sm:items-center sm:justify-between" data-billing-charge>
        <div><p class="font-medium"><%= friendly_date(charge.created_at) %></p><p class="text-sm text-muted-foreground"><%= pay_amount_to_currency(charge) %></p></div>
        <div class="flex gap-4"><%= link_to t(".invoice"), invoice_billing_charge_path(charge, format: :pdf), target: :_blank, class: "text-sm font-medium text-primary" %><%= link_to t(".receipt"), billing_charge_path(charge, format: :pdf), target: :_blank, class: "text-sm font-medium text-primary" %></div>
      </div>
    <% end %>
  </div>

  <% if @pagy.pages > 1 %>
    <%= render PaginationComponent.new(pagy: @pagy, classes: "mt-6") %>
  <% end %>
<% else %>
  <p class="text-muted-foreground"><%= t(".empty") %></p>
<% end %>
