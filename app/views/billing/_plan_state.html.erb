<%# locals: (subscription:) %>
<% if current_account.free? %>
  <%= render CardComponent.new(classes: "mb-8") do |card| %>
    <% card.with_body do %>
      <h2 class="font-serif text-lg font-normal text-foreground"><%= t("billing.show.free_title") %></h2>
      <p class="mt-2 text-muted-foreground"><%= t("billing.show.free_description", count: Account::FREE_LEARNER_LIMIT) %></p>
      <%= render ButtonComponent.new(text: t("billing.show.upgrade"), href: pricing_path, classes: "mt-4") %>
    <% end %>
  <% end %>
<% elsif current_account.complimentary_premium? && subscription.nil? %>
  <div class="mb-8">
    <%= render BadgeComponent.new(text: t("billing.show.complimentary_premium"), variant: :purple) %>
    <p class="mt-2 text-muted-foreground"><%= t("billing.show.complimentary_description") %></p>
    <%= render ButtonComponent.new(text: t("billing.show.subscribe"), href: pricing_path, variant: :secondary, classes: "mt-4") %>
  </div>
<% else %>
  <div class="mb-8">
    <%= render BadgeComponent.new(text: t("billing.show.premium"), variant: subscription&.past_due? ? :red : :green) %>
    <% if subscription&.on_grace_period? && subscription.ends_at? %>
      <%= render AlertComponent.new(title: t("billing.show.premium_until", date: friendly_date(subscription.ends_at)), variant: :warning, classes: "mt-3") %>
    <% elsif (pending_change = subscription&.pending_plan_change) %>
      <%= render AlertComponent.new(
        title: t("billing.show.pending_plan_change_title", date: friendly_date(pending_change[:starts_at])),
        description: t("billing.show.pending_plan_change_description", price: pay_amount_to_currency(pending_change[:plan])),
        variant: :info,
        classes: "mt-3"
      ) %>
    <% elsif subscription&.current_period_end? %>
      <p class="mt-2 text-muted-foreground"><%= t("billing.show.renews_on", date: friendly_date(subscription.current_period_end)) %></p>
    <% else %>
      <p class="mt-2 text-muted-foreground"><%= t("billing.show.renewal_date_unavailable") %></p>
    <% end %>
  </div>
<% end %>
