<div <%= tag.attributes(controller_data) %> data-action="ui-modal-unsaved-changes:discard->ui-modal#close ui-modal-unsaved-changes:visibility-changed->ui-modal#updateFocusableElements">
  <% if trigger? %>
    <%= trigger %>
  <% else %>
    <button class="<%= trigger_button_classes %>" data-action="click->ui-modal#open:prevent">
      <%= trigger_text %>
    </button>
  <% end %>

  <dialog class="<%= dialog_classes %>" data-ui-modal-target="dialog" data-ui-modal-unsaved-changes-target="dialog" data-action="mousedown->ui-modal#backdropClose turbo:frame-load->ui-modal-unsaved-changes#clearDirty">
    <div class="<%= content_wrapper_classes %>">
      <% if show_close_button %>
        <button type="button" data-action="ui-modal#close:prevent" class="<%= close_button_classes %>">
          <%= render_close_icon %>
          <span class="sr-only">Close</span>
        </button>
      <% end %>

      <% if header? %>
        <%= header %>
      <% elsif title.present? %>
        <h2 class="<%= title_classes %>"><%= title %></h2>
      <% end %>

      <%# AIDEV-NOTE: Lazy loading replaces only this region, preserving the dialog title and Close control. %>
      <div data-ui-modal-content>
        <%= content %>
      </div>

      <% if footer? %>
        <div class="<%= footer_classes %>">
          <%= footer %>
        </div>
      <% end %>

      <div class="hidden sticky bottom-0 mt-4 border-t border-neutral-200 bg-white pt-4 dark:border-neutral-700 dark:bg-neutral-800" data-ui-modal-unsaved-changes-target="discardPrompt">
        <p class="font-sans text-sm font-medium"><%= t("ui_modal.discard_prompt.title") %></p>
        <div class="mt-3 flex justify-end gap-2">
          <%= render ButtonComponent.new(text: t("ui_modal.discard_prompt.keep_editing"), variant: :secondary, data: {action: "click->ui-modal-unsaved-changes#keepEditing"}) %>
          <%= render ButtonComponent.new(text: t("ui_modal.discard_prompt.discard"), data: {action: "click->ui-modal-unsaved-changes#discard"}) %>
        </div>
      </div>
    </div>
  </dialog>
</div>
